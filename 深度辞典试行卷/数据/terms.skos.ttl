@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gl: <urn:gelug-glossary:deep:> .

gl:scheme a skos:ConceptScheme ; skos:prefLabel "格魯派圓滿次第核心名相"@zh-Hant .

gl:rdzogs-rim a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "圓滿次第"@zh-Hant , "རྫོགས་རིམ"@bo , "rdzogs rim / rdzogs pa'i rim pa"@bo-Latn ;
  skos:altLabel "pariniṣpannayoga（《五次第》2.52 之用語）"@sa-Latn ;
  skos:altLabel "completion stage"@en ;
  skos:altLabel "perfection stage"@en ;
  skos:definition "不觀待分別假立，直緣自身生時本有之脈、風、明點而修，令風入、住、融於中脈之瑜伽次第。"@zh-Hant ;
  skos:related gl:lus-dben ;
  skos:related gl:rim-lnga ;
  skos:related gl:gnad-bsnun .

gl:rim-lnga a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "五次第・六次第"@zh-Hant , "རིམ་པ་ལྔ"@bo , "rim pa lnga / rim pa drug"@bo-Latn ;
  skos:altLabel "pañcakrama"@sa-Latn ;
  skos:altLabel "five stages"@en ;
  skos:altLabel "six stages"@en ;
  skos:definition "密集聖派圓滿次第之分科。龍猛《五次第》立金剛念誦（語遠離）、心清淨（心遠離）、自加持（幻身）、樂現覺（光明）、雙運五次第；聖天《攝行炬論》廣釋中為身遠離別立一品而成六次第；《明炬論》第一品則攝前二遠離於心觀而立四次第。三者為同一道次第之開合，前後次第決定。"@zh-Hant ;
  skos:related gl:lus-dben ;
  skos:related gl:ngag-dben ;
  skos:related gl:sems-dben ;
  skos:related gl:sgyu-lus ;
  skos:related gl:od-gsal ;
  skos:related gl:zung-jug .

gl:lus-dben a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "身遠離"@zh-Hant , "ལུས་དབེན"@bo , "lus dben"@bo-Latn ;
  skos:altLabel "kāyaviveka"@sa-Latn ;
  skos:altLabel "body isolation"@en ;
  skos:definition "以通達空性、與之無二之智現為天身，觀自身蘊、界、處等為一部乃至百部諸尊，以淨除庸常慢之圓滿次第初位；其樂須由風入中脈而融所生。"@zh-Hant ;
  skos:related gl:rdzogs-rim ;
  skos:related gl:rim-lnga ;
  skos:related gl:ngag-dben .

gl:ngag-dben a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "語遠離（金剛念誦・命勤）"@zh-Hant , "ངག་དབེན"@bo , "ngag dben / rdo rje'i bzlas pa / srog rtsol"@bo-Latn ;
  skos:altLabel "vāgviveka; vajrajāpa; prāṇāyāma"@sa-Latn ;
  skos:altLabel "speech isolation"@en ;
  skos:altLabel "vajra recitation"@en ;
  skos:altLabel "prāṇāyāma"@en ;
  skos:definition "於身遠離之上，以命勤瑜伽令風入、住、融於中脈，於語之根本風得自在之圓滿次第。“語遠離”“金剛念誦”皆就命勤之一分立名；此次第之總名為命勤（prāṇāyāma），即《後續》六支之第三。"@zh-Hant ;
  skos:related gl:lus-dben ;
  skos:related gl:sems-dben ;
  skos:related gl:gnad-bsnun .

gl:sems-dben a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "心遠離"@zh-Hant , "སེམས་དབེན"@bo , "sems dben"@bo-Latn ;
  skos:altLabel "cittaviveka"@sa-Latn ;
  skos:altLabel "mind isolation"@en ;
  skos:definition "身遠離究竟、語遠離得風自在之後，以內緣（風與明點之命勤）與外緣（業手印、智手印）令風融入心間中脈，次第生起明、增、近得三空之智，其究竟為喻光明之圓滿次第。"@zh-Hant ;
  skos:related gl:ngag-dben ;
  skos:related gl:stong-bzhi ;
  skos:related gl:dpe-don .

gl:stong-bzhi a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "四空（空・極空・大空・一切空）"@zh-Hant , "སྟོང་པ་བཞི"@bo , "stong pa bzhi"@bo-Latn ;
  skos:altLabel "śūnya；atiśūnya；mahāśūnya；sarvaśūnya"@sa-Latn ;
  skos:altLabel "four empties"@en ;
  skos:definition "粗分風心次第融攝時所現之四種心：明（空）、增（極空）、近得（大空），及其後之光明（一切空）。“空”指空去粗分分別及其所乘之風，非即所證之空性。"@zh-Hant ;
  skos:related gl:sems-dben ;
  skos:related gl:od-gsal ;
  skos:related gl:gzhi-rim-lnga .

gl:gzhi-rim-lnga a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "基位五次第"@zh-Hant , "གཞིའི་རིམ་ལྔ"@bo , "gzhi'i rim lnga"@bo-Latn ;
  skos:altLabel "five stages at the time of the basis"@en ;
  skos:definition "宗喀巴以道位五次第與凡夫生死之過程相配（對應）：風息出入為基位金剛念誦，死時三相為基位心遠離，死光明為基位光明（基位法身），中有身為基位幻身（基位報身），受生為基位化身。"@zh-Hant ;
  skos:related gl:stong-bzhi ;
  skos:related gl:sgyu-lus ;
  skos:related gl:od-gsal ;
  skos:related gl:rim-lnga .

gl:sgyu-lus a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "幻身"@zh-Hant , "སྒྱུ་ལུས"@bo , "sgyu lus / sgyu ma'i sku"@bo-Latn ;
  skos:altLabel "māyādeha"@sa-Latn ;
  skos:altLabel "illusory body"@en ;
  skos:definition "三空之後，唯由逆起之三心及其所乘之風——極細風心——自身現為金剛薩埵之身；其身之近取因為風，前心為俱有緣；其意之近取因為前心，風為俱有緣。"@zh-Hant ;
  skos:related gl:sgyu-lus-dag ;
  skos:related gl:od-gsal ;
  skos:related gl:zung-jug ;
  skos:related gl:rdzogs-rim ;
  skos:related gl:gzhi-rim-lnga .

gl:sgyu-lus-dag a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "不淨幻身・清淨幻身"@zh-Hant , "མ་དག་པའི་སྒྱུ་ལུས"@bo , "ma dag pa'i sgyu lus / dag pa'i sgyu ma'i sku"@bo-Latn ;
  skos:altLabel "impure illusory body"@en ;
  skos:altLabel "pure illusory body"@en ;
  skos:definition "不淨幻身：心遠離究竟之喻光明後，從其風心逆起所成之幻身；未以樂現證真實，屬加行道；入義光明時全然無有。清淨幻身：從義光明逆起所成之幻身，與初得有學雙運同時；其時立為已斷俱生煩惱，身為清淨幻身，意與義光明同體俱轉。"@zh-Hant ;
  skos:related gl:sgyu-lus ;
  skos:related gl:dpe-don ;
  skos:related gl:zung-jug ;
  skos:related gl:spangs-rtogs .

gl:od-gsal a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "光明（境光明・有境光明）"@zh-Hant , "འོད་གསལ"@bo , "'od gsal / yul gyi 'od gsal / yul can gyi 'od gsal"@bo-Latn ;
  skos:altLabel "prabhāsvara"@sa-Latn ;
  skos:altLabel "clear light"@en ;
  skos:altLabel "object clear light"@en ;
  skos:altLabel "subject clear light"@en ;
  skos:definition "光明一名須分境、有境。就有境言，指三空清淨、微細二相亦淨之最細心：基位為死光明，道位分喻光明、義光明，果位為智慧法身。就境言，指其所證之法性（諸法自性光明）；果位之境光明，宗喀巴說為具二清淨之無為法身。"@zh-Hant ;
  skos:related gl:stong-bzhi ;
  skos:related gl:dpe-don ;
  skos:related gl:gzhi-rim-lnga ;
  skos:related gl:zung-jug .

gl:dpe-don a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "喻光明・義光明"@zh-Hant , "དཔེའི་འོད་གསལ"@bo , "dpe'i 'od gsal / don gyi 'od gsal"@bo-Latn ;
  skos:altLabel "example clear light"@en ;
  skos:altLabel "meaning clear light"@en ;
  skos:definition "二者皆道位第四空（一切空）之光明心。義光明：微細二相畢竟清淨，以樂現證真實，其後成雙運之身，配見道。喻光明：其後成幻身，其時尚未以樂現證真實，屬加行道；從身遠離至幻身之間皆可生起。"@zh-Hant ;
  skos:related gl:od-gsal ;
  skos:related gl:sgyu-lus-dag ;
  skos:related gl:sems-dben ;
  skos:related gl:zung-jug .

gl:ril-rjes a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "整持・隨滅"@zh-Hant , "རིལ་འཛིན"@bo , "ril 'dzin / rjes gzhig"@bo-Latn ;
  skos:altLabel "piṇḍagrāha; anubheda"@sa-Latn ;
  skos:altLabel "holding the body entirely"@en ;
  skos:altLabel "subsequent destruction"@en ;
  skos:definition "收入光明之二種靜慮。整持：自頂向下、自足向上收攝，二者終點皆在心間，如呵氣於鏡，氣從四邊聚於中央；隨滅：先收器世間與有情入光明，後收自身。自身諸蘊之次第壞滅二者皆有，其差別唯在是否先收器情。"@zh-Hant ;
  skos:related gl:sgyu-lus ;
  skos:related gl:od-gsal .

gl:zung-jug a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "雙運（有學・無學）"@zh-Hant , "ཟུང་འཇུག"@bo , "zung 'jug / slob pa'i zung 'jug / mi slob pa'i zung 'jug"@bo-Latn ;
  skos:altLabel "yuganaddha"@sa-Latn ;
  skos:altLabel "union"@en ;
  skos:altLabel "learner's union"@en ;
  skos:altLabel "union of no-more-learning"@en ;
  skos:definition "從義光明逆起之清淨幻身（身）與義光明（意）同體而轉之位；宗喀巴並以斷除執人、法諦實之一切分別及其種子之無二智名為雙運。有學位猶暫現任持異熟身相；究竟法身現前時，有學雙運之幻化身轉為無學雙運之身。"@zh-Hant ;
  skos:related gl:sgyu-lus-dag ;
  skos:related gl:od-gsal ;
  skos:related gl:spangs-rtogs .

gl:spangs-rtogs a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "斷之雙運・證之雙運"@zh-Hant , "སྤངས་པའི་ཟུང་འཇུག"@bo , "spangs pa'i zung 'jug / rtogs pa'i zung 'jug"@bo-Latn ;
  skos:altLabel "union of abandonment"@en ;
  skos:altLabel "union of realization"@en ;
  skos:definition "有學雙運之二分（名出後期地道教本）。斷之雙運：從義光明初起、清淨幻身成就之同時，俱生煩惱立為已斷，此清淨幻身與煩惱障斷除之合。證之雙運：其後具清淨幻身者復入義光明，入出光明就心而作，幻身相續不斷，此清淨幻身與義光明同時之合。"@zh-Hant ;
  skos:related gl:zung-jug ;
  skos:related gl:sgyu-lus-dag .

gl:gnad-bsnun a skos:Concept ; skos:inScheme gl:scheme ;
  skos:prefLabel "扼身要"@zh-Hant , "ལུས་ལ་གནད་དུ་བསྣུན་པ"@bo , "lus la gnad du bsnun pa"@bo-Latn ;
  skos:altLabel "penetrating the vital points of the body"@en ;
  skos:definition "緣自身之脈、風、明點等要處而修，令左右風入、住、融於中脈之總方法。依聖派，先扼密處輪，次扼心間輪；其勝處在心間脈輪中央。"@zh-Hant ;
  skos:related gl:rdzogs-rim ;
  skos:related gl:ngag-dben .
